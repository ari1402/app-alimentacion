# Copiá este archivo a .env.local (está en .gitignore) y completá.
#
# ⚠️  Solo las variables que empiezan con VITE_ llegan al navegador.
#     NUNCA pongas acá una clave con prefijo VITE_ que sea secreta.

# ── Frontend (públicas por diseño) ──────────────────────
# Si las dejás vacías, la app corre en "modo local" (datos en el dispositivo).
VITE_SUPABASE_URL=
# La anon key de Supabase es pública: la protección real son las políticas RLS.
VITE_SUPABASE_ANON_KEY=
# Clave PÚBLICA VAPID para Web Push (npm run vapid la genera).
VITE_VAPID_PUBLIC_KEY=

# ── Solo para `npm run dev` en modo local (lado servidor de Vite) ──
# Vite NO expone esta variable al bundle porque no tiene prefijo VITE_.
# En producción la key vive como secreto de Supabase, no acá.
ANTHROPIC_API_KEY=
