{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@core": ["supabase/functions/_shared/core/index.ts"],
      "@core/*": ["supabase/functions/_shared/core/*"],
      "@ai/*": ["supabase/functions/_shared/ai/*"]
    }
  },
  "include": ["src", "tests", "vite.config.ts", "supabase/functions/_shared/core", "supabase/functions/_shared/ai", "dev"]
}
