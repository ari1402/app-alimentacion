# Secretos de las Edge Functions.
# Local:      copiá a supabase/functions/.env  (en .gitignore) y usá `supabase functions serve`
# Producción: `supabase secrets set --env-file supabase/functions/.env`
#             o uno por uno: `supabase secrets set ANTHROPIC_API_KEY=sk-ant-...`

# OPCIONAL si cargás la key desde la app (Ajustes → API key de Claude: queda cifrada en Vault).
ANTHROPIC_API_KEY=
# Emails autorizados a usar la key GLOBAL de arriba (separados por coma). Si usás la
# key global, es obligatorio: sin la lista, nadie la puede usar (protege tus créditos).
ALLOWED_EMAILS=
# Web Push (generalas con `npm run vapid`)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-mail@ejemplo.com
# Secreto compartido entre pg_cron y la función coach-tick (cualquier string largo al azar)
CRON_SECRET=
# Opcionales: modelos
# MODEL_PARSE=claude-haiku-5-5
# MODEL_COACH=claude-opus-5-5
